+// static
+DataVector<uint8_t> JpegModule::Encode(pdfium::span<const uint8_t> pixels,
+                                       int width,
+                                       int height,
+                                       int components,
+                                       int quality,
+                                       pdfium::span<const uint8_t> like) {
+  if (width <= 0 || height <= 0 || (components != 1 && components != 3)) {
+    return {};
+  }
+  FX_SAFE_SIZE_T size = width;
+  size *= height;
+  size *= components;
+  if (!size.IsValid() || size.ValueOrDie() != pixels.size()) {
+    return {};
+  }
+  unsigned char* out = nullptr;
+  unsigned long out_size = 0;
+  if (!jpeg_common_encode(pixels.data(), width, height, components, quality,
+                          like.data(), like.size(), &out, &out_size)) {
+    return {};
+  }
+  // SAFETY: jpeg_common_encode() wrote `out_size` bytes to `out`.
+  DataVector<uint8_t> result(out, UNSAFE_BUFFERS(out + out_size));
+  free(out);
+  return result;
+}
