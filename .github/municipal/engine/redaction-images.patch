+struct JpegEncoder {
+  struct jpeg_error_mgr error_mgr;
+  jmp_buf jmpbuf;
+  struct jpeg_compress_struct cinfo;
+  struct jpeg_destination_mgr dest_mgr;
+  struct jpeg_decompress_struct like_info;
+  struct jpeg_source_mgr like_src;
+  const unsigned char* pixels;
+  unsigned int width;
+  unsigned int height;
+  int components;
+  int quality;
+  const unsigned char* like;
+  unsigned long like_size;
+  unsigned char* buf;
+  size_t buf_size;
+};
+typedef struct JpegEncoder JpegEncoder;
+
+static void jpeg_encode_error_exit(j_common_ptr cinfo) {
+  longjmp(((JpegEncoder*)cinfo->client_data)->jmpbuf, -1);
+}
+
+static void jpeg_encode_dest_init(j_compress_ptr cinfo) {
+  JpegEncoder* enc = (JpegEncoder*)cinfo->client_data;
+  enc->buf_size = 65536;
+  enc->buf = (unsigned char*)malloc(enc->buf_size);
+  if (!enc->buf) {
+    jpeg_encode_error_exit((j_common_ptr)cinfo);
+  }
+  enc->dest_mgr.next_output_byte = enc->buf;
+  enc->dest_mgr.free_in_buffer = enc->buf_size;
+}
+
+// Called when the whole buffer is full: double it.
+static boolean jpeg_encode_dest_grow(j_compress_ptr cinfo) {
+  JpegEncoder* enc = (JpegEncoder*)cinfo->client_data;
+  unsigned char* grown = (unsigned char*)realloc(enc->buf, enc->buf_size * 2);
+  if (!grown) {
+    jpeg_encode_error_exit((j_common_ptr)cinfo);
+  }
+  enc->buf = grown;
+  // SAFETY: `grown` holds 2 * buf_size bytes.
+  UNSAFE_BUFFERS(enc->dest_mgr.next_output_byte = grown + enc->buf_size);
+  enc->dest_mgr.free_in_buffer = enc->buf_size;
+  enc->buf_size *= 2;
+  return TRUE;
+}
+
+static void jpeg_encode_dest_term(j_compress_ptr cinfo) {}
+
+static void jpeg_encode_like_noop(j_decompress_ptr cinfo) {}
+
+static boolean jpeg_encode_like_fill(j_decompress_ptr cinfo) {
+  return FALSE;
+}
+
+static void jpeg_encode_like_skip(j_decompress_ptr cinfo, long num) {
+  if (num <= 0) {
+    return;
+  }
+  if (num > (long)cinfo->src->bytes_in_buffer) {
+    jpeg_encode_error_exit((j_common_ptr)cinfo);
+  }
+  // SAFETY: checked against bytes_in_buffer above.
+  UNSAFE_BUFFERS(cinfo->src->next_input_byte += num);
+  cinfo->src->bytes_in_buffer -= num;
+}
+
+// Copies the quantization tables (and, RGB to RGB, the chroma sampling) of the
+// JPEG in `like` into the compressor, so a re-encode keeps the source's size
+// and look.
+static void jpeg_encode_copy_like(JpegEncoder* enc,
+                                  const unsigned char* like,
+                                  unsigned long like_size) {
+  struct jpeg_decompress_struct* d = &enc->like_info;
+  struct jpeg_compress_struct* c = &enc->cinfo;
+  d->err = &enc->error_mgr;
+  d->client_data = enc;
+  jpeg_create_decompress(d);
+  enc->like_src.init_source = jpeg_encode_like_noop;
+  enc->like_src.fill_input_buffer = jpeg_encode_like_fill;
+  enc->like_src.skip_input_data = jpeg_encode_like_skip;
+  enc->like_src.resync_to_restart = jpeg_resync_to_restart;
+  enc->like_src.term_source = jpeg_encode_like_noop;
+  enc->like_src.next_input_byte = like;
+  enc->like_src.bytes_in_buffer = like_size;
+  d->src = &enc->like_src;
+  if (jpeg_read_header(d, TRUE) == JPEG_HEADER_OK) {
+    for (int ci = 0; ci < c->num_components && ci < 2; ++ci) {
+      const int src_ci = ci < d->num_components ? ci : 0;
+      const int tbl = d->comp_info[src_ci].quant_tbl_no;
+      const JQUANT_TBL* t =
+          tbl >= 0 && tbl < NUM_QUANT_TBLS ? d->quant_tbl_ptrs[tbl] : NULL;
+      if (!t) {
+        break;
+      }
+      unsigned int basic[DCTSIZE2];
+      for (int k = 0; k < DCTSIZE2; ++k) {
+        basic[k] = t->quantval[k];
+      }
+      jpeg_add_quant_table(c, ci, basic, 100, TRUE);
+    }
+    if (c->num_components == 3 && d->num_components == 3) {
+      for (int ci = 0; ci < 3; ++ci) {
+        c->comp_info[ci].h_samp_factor = d->comp_info[ci].h_samp_factor;
+        c->comp_info[ci].v_samp_factor = d->comp_info[ci].v_samp_factor;
+      }
+    }
+  }
+  jpeg_destroy_decompress(d);
+}
+
+// All libjpeg calls of an encode. External linkage and noinline keep it a
+// separate void(ptr, ptr) function: see jpeg_encode_frame().
+__attribute__((noinline)) void jpeg_common_encode_run(JpegEncoder* enc, const unsigned char* pixels) {
+  jpeg_create_compress(&enc->cinfo);
+  enc->dest_mgr.init_destination = jpeg_encode_dest_init;
+  enc->dest_mgr.empty_output_buffer = jpeg_encode_dest_grow;
+  enc->dest_mgr.term_destination = jpeg_encode_dest_term;
+  enc->cinfo.dest = &enc->dest_mgr;
+  enc->cinfo.image_width = enc->width;
+  enc->cinfo.image_height = enc->height;
+  enc->cinfo.input_components = enc->components;
+  enc->cinfo.in_color_space = enc->components == 1 ? JCS_GRAYSCALE : JCS_RGB;
+  jpeg_set_defaults(&enc->cinfo);
+  jpeg_set_quality(&enc->cinfo, enc->quality, TRUE);
+  if (enc->like && enc->like_size) {
+    jpeg_encode_copy_like(enc, enc->like, enc->like_size);
+  }
+  jpeg_start_compress(&enc->cinfo, TRUE);
+  const size_t stride = (size_t)enc->width * (size_t)enc->components;
+  while (enc->cinfo.next_scanline < enc->height) {
+    JSAMPROW row;
+    // SAFETY: the caller passes `height` rows of `stride` bytes.
+    UNSAFE_BUFFERS(row = (JSAMPROW)(pixels + enc->cinfo.next_scanline * stride));
+    jpeg_write_scanlines(&enc->cinfo, &row, 1);
+  }
+  jpeg_finish_compress(&enc->cinfo);
+  jpeg_destroy_compress(&enc->cinfo);
+}
+
+// The setjmp() frame holds exactly one call. Under Emscripten each call in it
+// becomes an invoke_* import, the imports are named by how often they are
+// called, and the viewer ships prebuilt JS for upstream's names: one more
+// void(ptr, ptr) call (13 already, next 6) keeps every name in place.
+__attribute__((noinline)) static boolean jpeg_encode_frame(JpegEncoder* enc) {
+  if (setjmp(enc->jmpbuf) == -1) {
+    return FALSE;
+  }
+  jpeg_common_encode_run(enc, enc->pixels);
+  return TRUE;
+}
+
+static boolean jpeg_encode_once(const unsigned char* pixels,
+                                unsigned int width,
+                                unsigned int height,
+                                int components,
+                                int quality,
+                                const unsigned char* like,
+                                unsigned long like_size,
+                                unsigned char** out,
+                                unsigned long* out_size) {
+  JpegEncoder* enc = (JpegEncoder*)calloc(1, sizeof(JpegEncoder));
+  if (!enc) {
+    return FALSE;
+  }
+  enc->pixels = pixels;
+  enc->width = width;
+  enc->height = height;
+  enc->components = components;
+  enc->quality = quality;
+  enc->like = like;
+  enc->like_size = like_size;
+  // Set up by hand like the decoders: jpeg_std_error() links exit().
+  enc->error_mgr.error_exit = jpeg_encode_error_exit;
+  enc->error_mgr.emit_message = jpeg_common_error_do_nothing_int;
+  enc->error_mgr.output_message = jpeg_common_error_do_nothing;
+  enc->error_mgr.format_message = jpeg_common_error_do_nothing_char;
+  enc->error_mgr.reset_error_mgr = jpeg_common_error_do_nothing;
+  enc->cinfo.err = &enc->error_mgr;
+  enc->cinfo.client_data = enc;
+  const boolean ok = jpeg_encode_frame(enc);
+  if (ok) {
+    *out = enc->buf;
+    *out_size = (unsigned long)(enc->buf_size - enc->dest_mgr.free_in_buffer);
+  } else {
+    jpeg_destroy_decompress(&enc->like_info);
+    jpeg_destroy_compress(&enc->cinfo);
+    free(enc->buf);
+  }
+  free(enc);
+  return ok;
+}
+
+boolean jpeg_common_encode(const unsigned char* pixels,
+                           unsigned int width,
+                           unsigned int height,
+                           int components,
+                           int quality,
+                           const unsigned char* like,
+                           unsigned long like_size,
+                           unsigned char** out,
+                           unsigned long* out_size) {
+  // A source header libjpeg rejects only costs its tables: retry with
+  // `quality` instead of writing the image uncompressed.
+  return jpeg_encode_once(pixels, width, height, components, quality, like,
+                          like_size, out, out_size) ||
+         (like && jpeg_encode_once(pixels, width, height, components, quality,
+                                   NULL, 0, out, out_size));
+}
+
